# Base URL of the existing Express API, including the /api suffix.
# The port must match PORT in server/.env (currently 5050).
# Physical devices cannot reach `localhost` — use your machine's LAN IP or a deployed URL.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5050/api

# Optional: origin serving /uploads/* if it differs from the API origin.
# EXPO_PUBLIC_ASSETS_URL=

# Optional: origin serving the web app's public files, for CMS values that store
# root-relative paths like "/lobby.jpeg".
# EXPO_PUBLIC_WEB_URL=
